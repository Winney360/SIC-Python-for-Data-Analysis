   ],
   "source": [
    "def sum_range(n,k):\n",
    "    if n == k:\n",
    "        return n\n",
    "    else:\n",
    "        return n + sum_range(n+1, k)\n",
    "\n",
    "print(f\"The sum is : {sum_range(0,100)}\")\n"
   ]
