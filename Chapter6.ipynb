   "source": [
    "def sum_num(n):\n",
    "    if n == 1:\n",
    "        return 1\n",
    "    else:\n",
    "        return n + sum_num(n-1)\n",
    "print(f\"The sum is : {sum_num(100)}\")"
   ]
  },
